{
  "name": "@t4dhg/mcp-factorial",
  "version": "13.0.0",
  "mcpName": "io.github.t4dhg/mcp-factorial",
  "description": "The definitive MCP server for FactorialHR - Full CRUD operations for employees, teams, time off, projects, training, recruiting (ATS), and payroll. Context-optimized with 14 hierarchical tools (117 operations) and safety guardrails.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-factorial": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "rm -rf dist coverage .vitest",
    "rebuild": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "scan": "node scripts/preflight-scan.mjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\"",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=low",
    "check:package": "node scripts/check-package.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run audit && npm run test && npm run build && npm run check:package && npm run test:smoke",
    "setup:hooks": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "factorial",
    "factorialhr",
    "factorial-hr",
    "hris",
    "hr",
    "hrm",
    "human-resources",
    "employee-management",
    "time-off",
    "attendance",
    "pto",
    "recruiting",
    "ats",
    "applicant-tracking",
    "training",
    "projects",
    "payroll",
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "llm",
    "ai-integration",
    "enterprise"
  ],
  "author": "Taig Mac Carthy <https://taigmaccarthy.com/>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4dhg/mcp-factorial.git"
  },
  "bugs": {
    "url": "https://github.com/t4dhg/mcp-factorial/issues"
  },
  "homepage": "https://github.com/t4dhg/mcp-factorial#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    }
  }
}
