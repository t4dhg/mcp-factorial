# FactorialHR API Configuration
# Copy this file to .env and fill in your values

# Your FactorialHR API key
# Get this from: https://app.factorialhr.com → Settings → Integrations → API
# A company API key acts as the company: writes made with it are recorded in
# Factorial under the key's account, not under you. Log in (see "User login"
# below) to have writes recorded under your own user. Optional once you have
# logged in; reads then see only what you may see.
FACTORIAL_API_KEY=your_api_key_here

# Optional: Your own employee id in Factorial
# Used as the default employee_id for attendance actions (clock_in, gaps,
# log_range, ...) and as the identity whose writes need no confirmation token.
# Writes aimed at anyone else, and every bulk write, return a preview and a
# token first. Find the id with factorial_employees({ action: 'search' }).
# It is also who you are for leave approvals: approve and reject only act on
# requests whose time-off approver is this employee, and refuse every request
# when it is unset. Ignored once you have logged in: you are then the employee
# who logged in.
# FACTORIAL_EMPLOYEE_ID=1234567

# Optional: Enable debug logging
# Set to 'true' to see detailed request/response logs
# DEBUG=false

# Optional: Factorial API version (advanced)
# Default: 2026-07-01
# Only change if you need to test against a different API version
# FACTORIAL_API_VERSION=2026-07-01

# Optional: Custom timeout in milliseconds
# Default: 30000 (30 seconds)
# FACTORIAL_TIMEOUT_MS=30000

# Optional: Maximum retry attempts for failed requests
# Default: 3
# FACTORIAL_MAX_RETRIES=3

# ============================================================================
# User login (writes recorded under your own user)
# ============================================================================
# 1. Create an OAuth application in Factorial (Settings → Advanced
#    configuration → OAuth applications): public client, redirect URI
#    http://127.0.0.1:53682/callback, scopes read and write plus one per area
#    you use (time_off, time_tracking, employees, documents, ...).
# 2. Set its client id below.
# 3. Run once in a terminal: npx -y @t4dhg/mcp-factorial login
#
# The login is stored outside this file, in ~/.config/mcp-factorial/login.json,
# readable by you only. See README.md for details.

# Client id of the OAuth application
# FACTORIAL_OAUTH_CLIENT_ID=your_oauth_client_id

# Client secret, only if the application is a confidential client
# FACTORIAL_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# Redirect URI registered on the application
# Default: http://127.0.0.1:53682/callback
# FACTORIAL_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/callback

# Scopes to request at login, space-separated. Unset leaves it to the application.
# FACTORIAL_OAUTH_SCOPES=read write time_off time_tracking employees

# Which credential writes use: auto (login when there is one, API key
# otherwise), oauth (never the API key) or api_key (ignore a stored login)
# Default: auto
# FACTORIAL_AUTH_MODE=auto

# Let approve and reject on leave requests run under a company API key. They
# are refused by default, because Factorial would record the decision under
# the key's account instead of under the person who took it.
# Default: false
# FACTORIAL_ALLOW_COMPANY_KEY_APPROVALS=false

# ============================================================================
# Document downloads without a login (older route)
# ============================================================================
# Document downloads need OAuth2. Once you have logged in they work with
# nothing else to configure. Without a login, supply a refresh token here
# together with the client id and secret above. A refresh token works once,
# so this value needs replacing after the server restarts.
# FACTORIAL_OAUTH_REFRESH_TOKEN=your_refresh_token
